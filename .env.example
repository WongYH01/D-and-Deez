# Copy to .env and fill in. .env is git-ignored and never baked into the image.
ANTHROPIC_API_KEY=
# Optional. Narration model, Campaign bible planning model (both default claude-sonnet-5-5) and Tool round cap per Turn (default 4).
# PIDM_MODEL=claude-sonnet-5-5
# PIDM_PLAN_MODEL=claude-sonnet-5-5
# PIDM_ROUND_CAP=4
# Optional. Recap model (default claude-haiku-5-5), token budget for the dynamic context plus recent Turns
# (default 8000) and the folder for Session-end backups (default /backups, mounted by compose.yaml).
# PIDM_RECAP_MODEL=claude-haiku-5-5
# PIDM_CONTEXT_BUDGET=8000
# PIDM_BACKUP_DIR=/backups
